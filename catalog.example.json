{
  "version": 1,
  "emulators": [
    {
      "id": "mgba",
      "name": "mGBA",
      "platform": "Game Boy Advance",
      "icon": {
        "file_id": ""
      },
      "download": {
        "file_id": "",
        "type": "zip"
      },
      "executable": "mGBA.exe",
      "setup_files": {
        "portable.ini": "",
        "config.ini": "[ports.qt]\nwidth=960\nheight=640\n"
      },
      "args": [
        "{rom}"
      ],
      "window_mode": "borderless",
      "rom_extensions": [
        ".gba"
      ],
      "save_extensions": [
        ".sav"
      ],
      "state_extensions": [
        ".ss1",
        ".ss2",
        ".ss3",
        ".ss4",
        ".ss5",
        ".ss6",
        ".ss7",
        ".ss8",
        ".ss9"
      ],
      "state_args": [
        "-t",
        "{state}",
        "{rom}"
      ],
      "games": [
        {
          "id": "pokemon-firered-ptbr",
          "title": "Pokémon FireRed",
          "subtitle": "",
          "rom": {
            "file_id": "",
            "filename": "firered.gba"
          },
          "cover": {
            "file_id": ""
          }
        },
        {
          "id": "pokemon-emerald-ptbr",
          "title": "Pokémon Emerald",
          "subtitle": "PT-BR",
          "rom": {
            "file_id": "",
            "filename": "emerald.gba"
          },
          "cover": {
            "file_id": ""
          }
        }
      ],
      "controls": {
        "file": "config.ini",
        "format": "ini",
        "section": "gba.input.QT_K",
        "key_encoding": "qt",
        "buttons": [
          {
            "id": "Up",
            "label": "Cima",
            "group": "dpad",
            "key": "keyUp",
            "default": "KeyW"
          },
          {
            "id": "Down",
            "label": "Baixo",
            "group": "dpad",
            "key": "keyDown",
            "default": "KeyS"
          },
          {
            "id": "Left",
            "label": "Esquerda",
            "group": "dpad",
            "key": "keyLeft",
            "default": "KeyA"
          },
          {
            "id": "Right",
            "label": "Direita",
            "group": "dpad",
            "key": "keyRight",
            "default": "KeyD"
          },
          {
            "id": "A",
            "label": "A",
            "group": "face",
            "key": "keyA",
            "default": "KeyK"
          },
          {
            "id": "B",
            "label": "B",
            "group": "face",
            "key": "keyB",
            "default": "KeyJ"
          },
          {
            "id": "L",
            "label": "L",
            "group": "shoulder",
            "key": "keyL",
            "default": "KeyQ"
          },
          {
            "id": "R",
            "label": "R",
            "group": "shoulder",
            "key": "keyR",
            "default": "KeyE"
          },
          {
            "id": "Start",
            "label": "Start",
            "group": "system",
            "key": "keyStart",
            "default": "Enter"
          },
          {
            "id": "Select",
            "label": "Select",
            "group": "system",
            "key": "keySelect",
            "default": "Space"
          }
        ]
      }
    }
  ]
}
